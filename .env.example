# ─── JobFill Pro v2 — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.

# Gemini API Key (required)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail OAuth2 (required for email sending)
# Set up at: https://console.cloud.google.com/ → APIs & Services → Credentials
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here

# Email Validation API (optional — skip for MVP)
# EMAIL_VALIDATION_API_KEY=your_key_here

# Server Port (do not change — hardcoded in extension manifest)
PORT=7823

# GitHub Personal Access Token (for 5000 req/hr API limit)
GITHUB_TOKEN=your_github_token_here
